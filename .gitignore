# Secrets
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist

# Dependencies and builds
node_modules/
dist/
# The design tokens' generated outputs are committed (ARCHITECTURE section 13).
!packages/design-tokens/dist/
.next/
build/
coverage/

# Playwright output: reports, traces, and the screenshots and diffs of failed
# tests. Committed baseline screenshots live in *-snapshots/ and are not ignored.
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Design-review screenshots the websites' Playwright tests write. Scoped to apps/
# so store/ listing screenshots stay committed.
apps/*/screenshots/

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# Images flutter test writes when a golden test fails. Committed goldens are not
# in failures/ folders.
apps/mobile/test/**/failures/

# OS and editors
.DS_Store
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json
