# FeenGo environment variables (docs/ARCHITECTURE.md section 19).
#
# Copy to .env for local development: `cp .env.example .env`. .env is git-ignored.
# Every value here is a placeholder that only works against the local Docker Compose
# services, which listen on 127.0.0.1. Staging and production values live in the
# host's secret store and GitHub Environments, never in a file in this repository.
#
# Later increments add their variables here.

# --- Local services: docker-compose.yml (C1) ---

# Postgres superuser for the local container only. The API never connects as it.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local-superuser-password

# Database created on first start.
POSTGRES_DB=feengo

# Passwords for the two roles created by docker/postgres/initdb/01-create-roles.sh.
# They are applied only when the database volume is first created; after changing
# them, recreate the volume with `docker compose down -v`.
FEENGO_MIGRATOR_PASSWORD=local-migrator-password
FEENGO_APP_PASSWORD=local-app-password

# Host ports, bound to 127.0.0.1. Change them if 5432 or 6379 is already in use.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API: apps/api (C2). APP_ENV is local, test, staging or production. ---
# All six are required; the API refuses to start if one is missing or wrong.
APP_ENV=local
PORT=3000
LOG_LEVEL=info
# Number of trusted proxy hops in X-Forwarded-For (0 locally).
TRUST_PROXY=0
# The API connects as feengo_app, never as the superuser.
DATABASE_URL=postgres://feengo_app:local-app-password@127.0.0.1:5432/feengo
REDIS_URL=redis://127.0.0.1:6379
