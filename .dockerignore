# Keeps the Docker build context small and free of secrets. Images are built from
# the repository root: docker build -f apps/api/Dockerfile .

# Secrets: never inside an image, at any depth (a bare `.env` would match only the
# context root). .env.example holds placeholders only.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.keystore
**/*.jks
**/*.p12
**/*.mobileprovision
**/google-services.json
**/GoogleService-Info.plist

# Dependencies and build output: installed and built inside the image.
**/node_modules
**/dist
**/.next
**/build
**/coverage
**/*.tsbuildinfo

# Not needed to build any image.
.git
.github
.claude
docs
store
apps/mobile
**/.DS_Store
**/.idea
**/.vscode
